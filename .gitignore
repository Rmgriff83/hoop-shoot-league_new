# Godot's import cache and editor state — regenerated by `godot --import`.
.godot/

# GodotIQ local state (bridge auth token) — do not commit
.godotiq/

# Build outputs (APKs, AABs, the iOS Xcode project). tools/build.sh rebuilds them.
build/
*.apk
*.aab
# The Android gradle build template Godot installs for the Play (AAB) preset
# (tools/build.sh --install-android-build-template); .build_version lives here too.
android/
# Vitest's cache at the root (the server's suite); never committed.
node_modules/

# Editor / OS noise
.DS_Store
*.blend1
*.tmp
__pycache__/

# The iOS plugin binaries (RevenueCat, AdMob, Game Center): staged from ~/.config/hoop_shoot/<plugin> by tools/build.sh.
ios/plugins/
# The AdMob plugin binaries (godot-admob): staged from ~/.config/hoop_shoot/admob by tools/build.sh,
# which also writes the addon's export .cfg files from data/ads.json.
addons/AdmobPlugin/bin/
addons/AdmobPlugin/ios_export.cfg
addons/AdmobPlugin/android_export.cfg
# RevenueCat public SDK keys (appl_/goog_), kept out of git like the keystore; see store_keys.example.json.
store_keys.json
