extends RefCounted
## The solo-mode HUD (docs/HOME.md → HUD): HudCopy's toast mapping, clock
## and BEST chip; every chip word in both faces; the Hud built
## off-tree (the clock or PRACTICE card, the score card, the BEST chip
## flipping to NEW BEST); the PauseMenu (RESUME / SHOT HELP / QUIT, the
## value cycles); the pause icon; the toggle switch.


func _app():
	return Engine.get_main_loop().root.get_node_or_null("App")


func run(t) -> void:
	_copy(t)
	_widgets(t)


func _copy(t) -> void:
	# Every mid-play call maps to a toast chip (designs 4a / 5a); nothing big mid-screen.
	var go := HudCopy.toast_for("GO!", Color.GREEN)
	t.eq([go["kind"], go["title"], go["pre"]], ["big", "GO", ""], "GO! is the big GO chip")
	t.ok(go["color"] == HudCopy.POP_ORANGE and absf(float(go["seconds"]) - Hud.GO_TOAST_S) < 1e-9, "…orange, up for GO_TOAST_S")
	var tm := HudCopy.toast_for("TIME!", RetroTheme.LIGHT["orange"])
	t.eq([tm["kind"], tm["title"], tm["icon"], tm["sub"]], ["small", "TIME!", "icon_stopwatch", ""], "TIME! is the small chip with the stopwatch")
	t.ok(tm["color"] == HudCopy.POP_ORANGE and absf(float(tm["seconds"]) - HudCopy.TOAST_S) < 1e-9 and not bool(tm["stay"]), "…orange, 2.8 s, gone by itself")
	t.eq(HudCopy.time_toast(31, true)["sub"], "SCORE 31 · NEW BEST", "the buzzer's toast carries the score and NEW BEST (design 5a)")
	t.eq([HudCopy.time_toast(12, false)["sub"], HudCopy.time_toast(12, false)["icon"]], ["SCORE 12", "icon_stopwatch"], "…or just the score")
	var on := HudCopy.toast_for("30s MODE: spots shuffle every 10 s", Color.WHITE)
	t.eq([on["title"], on["sub"], on["icon"]], ["30S MODE", "ON · SPOTS SHUFFLE", "icon_stopwatch"], "the 30s note is 30S MODE over ON · SPOTS SHUFFLE")
	t.eq(HudCopy.toast_for("30s MODE: hoop on the move", Color.WHITE)["sub"], "ON · HOOP ON THE MOVE", "…the cage's says the hoop moves")
	t.eq(HudCopy.toast_for("30s mode off", Color.WHITE)["sub"], "OFF", "…and OFF")
	var nx := HudCopy.toast_for("NEXT: L ELBOW IN 3", Color.WHITE)
	t.eq([nx["title"], nx["sub"], nx["icon"]], ["NEXT SPOT", "L ELBOW IN 3", "icon_stopwatch"], "the shuffle warning is NEXT SPOT over the spot and the seconds")
	t.ok(nx["color"] == HudCopy.POP_GOLD and bool(nx["stay"]), "…gold and staying (the seconds swap)")
	var ns := HudCopy.toast_for("NOW SHOOTING: R BASE", Color.WHITE)
	t.eq([ns["title"], ns["sub"], ns["stay"]], ["NEW SPOT", "MOVE TO R BASE", false], "the switch is NEW SPOT over MOVE TO the spot")
	t.ok(ns["color"] == HudCopy.POP_GOLD and absf(float(ns["seconds"]) - HudCopy.SHOOTING_TOAST_S) < 1e-9, "…gold, briefly")
	var dt := HudCopy.deal_toast("Deep Freeze", false, "Ollie")
	t.eq([dt["title"], dt["sub"], dt["target"]], ["DEEP FREEZE", "PLAYED ON OLLIE", "opp"], "a card played on the opponent")
	t.eq(HudCopy.deal_toast("Heat Check", true, "Ollie")["sub"], "PLAYED ON YOU", "…or on you")
	var other := HudCopy.toast_for("✨ something else", Color.RED)
	t.eq([other["kind"], other["title"]], ["small", "SOMETHING ELSE"], "anything else: a small chip, upper-cased, emoji dropped")
	t.ok(other["color"] == Color.RED, "…in the colour given")
	t.eq(HudCopy.clock_text(41.66), "41.7", "the clock")
	t.eq(HudCopy.clock_text(-0.2), "0.0", "never negative")
	t.eq(HudCopy.clock_text(12.3, 1), "OT1 12.3", "an OT tag")
	t.ok(HudCopy.clock_hot(9.9) and not HudCopy.clock_hot(10.1), "gold in the last ten seconds")
	t.eq(HudCopy.best_chip(29, 12), {"label": "BEST", "val": "29"}, "behind the best")
	t.eq(HudCopy.best_chip(29, 31), {"label": "NEW BEST", "val": "31"}, "past it")
	t.eq(HudCopy.best_chip(0, 0), {"label": "BEST", "val": "-"}, "no best yet")
	t.eq(HudCopy.best_chip(0, 1), {"label": "NEW BEST", "val": "1"}, "the first point is a new best")
	t.eq(HudCopy.deal_caption("Deep Freeze", false, "Ollie"), ["DEEP FREEZE", "OLLIE"], "a card on the opponent")
	t.eq(HudCopy.deal_caption("Heat Check", true, "Ollie"), ["HEAT CHECK", "YOU"], "a card on you")
	t.eq(HudCopy.ot_break(37, 37, 1, 20, true), {"sub": "TIED 37-37", "title": "OVERTIME", "note": "20 SECONDS · BOTH SHOOTERS BACK TO THE KEY"}, "the overtime card")
	t.eq(HudCopy.ot_break(40, 40, 2, 20, false)["title"], "OVERTIME 2", "a second period")
	t.eq(HudCopy.ot_break(40, 40, 2, 20, false)["note"], "20 SECONDS", "no spots, no key note")
	t.eq(HudCopy.shot_help_value(0), "OFF", "shot help off")
	t.eq(HudCopy.shot_help_value(2), "NUMBERS + ARC", "shot help full")
	var display := UiFont.display()
	var bold := UiFont.body_bold()
	for s in ["SWISH +2", "HEATING UP", "TIME!", "GO", "IN AND OUT", "BUZZER BEATER +3", "NEW BEST", "30S MODE", "ON · SPOTS SHUFFLE", "ON · HOOP ON THE MOVE", "OFF", "NEXT SPOT", "L ELBOW IN 3", "NEW SPOT", "MOVE TO L ELBOW", "STARTS IN", "OT1 12.3", "SCORE 31 · NEW BEST", "0.8S", "0.0S", "20S ON THE CLOCK", "PLAYED ON OLLIE", "SHOT HELP", "QUIT TO TITLE", "PAUSED", "RESUME"]:
		for ch in s:
			t.ok(display.has_char(ch.unicode_at(0)) and bold.has_char(ch.unicode_at(0)), "glyph '%s' in both faces (%s)" % [ch, s])


func _widgets(t) -> void:
	var app = _app()
	if app == null:
		return
	var hud := Hud.new()
	hud._ready()
	t.ok(hud.find_child("Clock", true, false).visible and not hud.find_child("Practice", true, false).visible, "a trial shows the clock card")
	t.ok(hud.find_child("ScoreCard", true, false) is ShadowPanel, "the score card")
	t.ok(not hud.find_child("BestChip", true, false).visible, "no BEST chip until set")
	hud.set_best(29)
	t.eq(hud.best_text(), "BEST 29", "the saved best")
	# A bright sky (the midday city) gets an ink wash behind the top cards.
	t.ok(not hud.has_top_wash(), "no wash by default")
	hud.set_top_wash(0.62)
	t.ok(hud.has_top_wash() and hud.get_child(0).name == "TopWash", "the wash sits under the cards")
	hud.set_top_wash(0.0)
	t.ok(not hud.has_top_wash(), "…and comes off")
	t.ok(float(CosmeticLibrary.get_arena("city").top_wash) > 0.5, "the city asks for the wash")
	t.eq(float(CosmeticLibrary.get_arena("cage").top_wash), 0.0, "the cage does not")
	hud.set_score(31)
	t.eq(hud.best_text(), "NEW BEST 31", "passing it flips the chip")
	hud.update_clock(41.66, 0.0, TimeTrial.PHASE_RUNNING)
	t.eq(hud.clock_text(), "41.7", "the clock text")
	hud.update_clock(2.0, 3.0, TimeTrial.PHASE_COUNTDOWN)
	var solo_big: Toast = hud.find_child("CountdownToast", true, false)
	t.ok(solo_big.visible and solo_big.title_text() == "3" and solo_big.pre_text() == "STARTS IN", "a solo trial counts down in the toast chip too")
	t.ok(hud.find_child("Countdown", true, false) == null, "…the 160 px digit is gone")
	# The mid-play calls as chips (designs 4a / 5a).
	hud.banner("GO!", Color(0.4, 0.9, 0.55))
	t.ok(solo_big.visible and solo_big.title_text() == "GO" and solo_big.color == HudCopy.POP_ORANGE, "GO! is the big orange GO chip")
	hud.update_clock(59.9, 0.0, TimeTrial.PHASE_RUNNING)
	t.ok(solo_big.visible, "…running leaves GO up")
	hud.time_toast(31, true)
	var chip: Toast = hud.find_child("Toast", true, false)
	t.ok(chip.visible and chip.title_text() == "TIME!" and chip.sub_text() == "SCORE 31 · NEW BEST" and chip.has_icon() and chip.color == HudCopy.POP_ORANGE, "TIME! is the orange chip with the stopwatch over the score")
	t.ok(absf(chip.size.y - (Toast.SIDE_SMALL_H + ShadowStyle.OFFSET)) < 0.5, "…72 tall (design 5a)")
	t.ok(chip.size.x >= Toast.SIDE_SMALL_MIN_W, "…at least 300 wide (%.0f)" % chip.size.x)
	t.ok(chip.mode == Toast.Mode.SIDE and chip.anchor_left == 0.0 and absf(chip.home_x() - Toast.SIDE_MARGIN) < 0.5, "…hangs off the left edge, 36 in")
	t.ok(absf((chip.offset_top + chip.offset_bottom - ShadowStyle.OFFSET) / 2.0 - Hud.TOAST_Y) < 1.0, "…centred a third of the way up (y 853)")
	t.ok(not chip.staying(), "…and goes by itself")
	t.ok(hud.find_child("Banner", true, false) == null and hud.find_child("Note", true, false) == null, "the centre banner and note are gone")
	hud.banner("30s MODE: hoop on the move", Color(1.0, 0.75, 0.3))
	t.eq([chip.title_text(), chip.sub_text()], ["30S MODE", "ON · HOOP ON THE MOVE"], "the 30s note is 30S MODE over ON · HOOP ON THE MOVE")
	hud.banner("NEXT: L ELBOW IN 3", Color(1.0, 0.75, 0.3))
	t.ok(chip.staying() and chip.title_text() == "NEXT SPOT" and chip.sub_text() == "L ELBOW IN 3" and chip.has_icon() and chip.color == HudCopy.POP_GOLD, "NEXT SPOT stays up in gold")
	hud.banner("NEXT: L ELBOW IN 2", Color(1.0, 0.75, 0.3))
	t.ok(chip.staying() and chip.sub_text() == "L ELBOW IN 2", "…the seconds swap without a re-slide")
	t.eq(hud.banner_text(), "NEXT SPOT L ELBOW IN 2", "what the chip reads")
	hud.hide_toast()
	hud.banner("NOW SHOOTING: L ELBOW", Color(0.4, 0.9, 0.55))
	t.ok(chip.visible and chip.title_text() == "NEW SPOT" and chip.sub_text() == "MOVE TO L ELBOW" and not chip.staying(), "the switch chip, briefly")
	hud.hide_toast()
	hud.hide_countdown_toast()
	hud.set_heat(true, "OLLIE", Color("#3E7C4F"))
	t.ok(hud.find_child("YouCard", true, false) is ShadowPanel and hud.find_child("OppCard", true, false) is ShadowPanel, "a heat shows the two side cards")
	t.ok(not hud.find_child("ScoreCard", true, false).visible and not hud.find_child("BestChip", true, false).visible, "and hides the score card and chip")
	t.eq((hud.find_child("OppCard", true, false) as ShadowPanel).color, Color("#3E7C4F"), "the opponent's card in their colour")
	hud.set_score(12)
	hud.set_opponent_score(9)
	for i in 120:
		hud._process(1.0 / 60.0)
	t.eq(hud.side_texts(), ["12", "9"], "the sides count up to their scores")
	hud.set_ot(1)
	t.ok(hud.find_child("OtTag", true, false).visible and (hud.find_child("OtTag", true, false) as Label).text == "OT1", "the OT tag")
	# The league's toasts (design 4a): the countdown is a chip, STARTS IN over the digit.
	hud.update_clock(60.0, 3.0, TimeTrial.PHASE_COUNTDOWN)
	var big: Toast = hud.find_child("CountdownToast", true, false)
	t.ok(big.visible and big.title_text() == "3" and big.pre_text() == "STARTS IN", "a heat counts down in the toast chip")
	t.ok(hud.find_child("Countdown", true, false) == null, "…there are no bare digits any more")
	hud.update_clock(60.0, 1.0, TimeTrial.PHASE_COUNTDOWN)
	t.eq(big.title_text(), "1", "…the digit swaps")
	t.ok(big.size.x >= Toast.SIDE_BIG_MIN_W and absf(big.size.y - (Toast.SIDE_BIG_H + ShadowStyle.OFFSET)) < 0.5, "the chip is at least 260 wide and 150 tall (%.0f × %.0f)" % [big.size.x, big.size.y])
	hud.go_toast()
	t.ok(big.visible and big.title_text() == "GO" and big.pre_text() == "" and big.color == RetroTheme.LIGHT["orange"], "GO is the same chip in orange")
	hud.update_clock(59.9, 0.0, TimeTrial.PHASE_RUNNING)
	t.ok(big.visible, "…and running does not cut GO short")
	hud.hide_countdown_toast()
	t.ok(not big.visible, "hidden on demand")
	hud.toast("OVERTIME", "20S ON THE CLOCK", "icon_stopwatch", Hud.GOLD)
	var small: Toast = hud.find_child("Toast", true, false)
	t.ok(small.visible and small.title_text() == "OVERTIME" and small.sub_text() == "20S ON THE CLOCK" and small.has_icon(), "the OVERTIME toast: stopwatch, title, 20S ON THE CLOCK")
	t.ok(absf(small.size.y - (Toast.SIDE_SMALL_H + ShadowStyle.OFFSET)) < 0.5 and hud.toast_shown(), "…72 tall and reported shown (%.1f)" % small.size.y)
	hud.hide_toast()
	t.ok(not hud.toast_shown(), "…hidden with the break")
	t.eq(HudCopy.ot_toast(1, 20), {"title": "OVERTIME", "sub": "20S ON THE CLOCK"}, "ot toast copy")
	t.eq(HudCopy.ot_toast(2, 20)["title"], "OVERTIME 2", "…numbered from the second")
	t.eq(HudCopy.countdown_pre(), "STARTS IN", "countdown pre-line")
	# The ball wait is the mini toast (design 4a, 2026-10-25): the ball and the seconds, gone by itself.
	hud.set_ball_wait(0.8)
	t.ok(hud.wait_shown() and small.is_mini() and small.title_text() == "0.8S" and small.has_icon() and not small.staying(), "the mini toast: the ball and 0.8S, gone by itself")
	t.ok(absf(small.size.y - (Toast.SIDE_MINI_H + ShadowStyle.OFFSET)) < 0.5 and small.size.x < Toast.SIDE_SMALL_MIN_W, "…60 tall, hugging its words (%.0f wide)" % small.size.x)
	t.ok(small.sub_text() == "" and hud.find_child("Wait", true, false) == null, "…no NEXT BALL words, no old chip")
	hud.set_ball_wait(0.5)
	t.eq(small.title_text(), "0.5S", "…the seconds tick down in place")
	hud.toast("OVERTIME", "20S ON THE CLOCK", "icon_stopwatch", Hud.GOLD)
	t.ok(not hud.wait_shown() and small.title_text() == "OVERTIME", "another notice takes the slot")
	hud.set_ball_wait(0.4)
	t.ok(small.title_text() == "OVERTIME", "…and keeps it while it is up")
	hud.hide_toast()
	t.ok(small.visible and small.leaving() and not hud.toast_shown(), "a notice taken down fades where it is")
	hud.set_ball_wait(0.4)
	t.ok(hud.wait_shown() and small.title_text() == "0.4S", "…and the wait takes the slot as it goes")
	hud.set_ball_wait(0.0)
	t.ok(not hud.wait_shown() and small.visible and small.title_text() == "0.0S", "the ball is ready: 0.0S, the toast fades on its own")
	t.eq([HudCopy.wait_title(0.84), HudCopy.wait_title(-0.2)], ["0.8S", "0.0S"], "the wait's words")
	t.ok(is_equal_approx(Toast.LIFE_IN + Toast.LIFE_FADE, 0.32) and is_equal_approx(Toast.LIFE_SETTLE, 0.16), "a toast's life: in by 12 %, settled by 16 %, faded over the last 20 %")
	# A card played: the thumb, the name over PLAYED ON …, the target badge (100 tall).
	hud.card_toast("DEEP FREEZE", "PLAYED ON OLLIE", CardDefs.get_card("ice"), "opp", LeagueContext.BLUE)
	t.ok(small.visible and small.has_thumb() and small.title_text() == "DEEP FREEZE" and small.sub_text() == "PLAYED ON OLLIE", "the card toast")
	t.eq(small.badge_name(), "cards/badge_opp_a", "…the opponent's badge")
	t.ok(absf(small.size.y - (Toast.SIDE_CARD_H + ShadowStyle.OFFSET)) < 0.5, "…100 tall")
	hud.card_toast("HEAT CHECK", "PLAYED ON YOU", CardDefs.get_card("fire7"), "self", RetroTheme.LIGHT["orange"])
	t.eq(small.badge_name(), "cards/badge_self_b", "…your badge for a card on you")
	hud.hide_toast()
	hud.set_practice(true, "BEACH")
	t.ok(hud.find_child("Practice", true, false).visible and not hud.find_child("Clock", true, false).visible, "practice swaps in its card")
	t.eq((hud.find_child("PracticeLabel", true, false) as Label).text, "BEACH", "with the area's label")
	hud.free()
	# HUD SIDE: RIGHT (Ross, 2026-10-24) — the toasts hang off the right edge and the note moves over.
	var was_side: String = app.hud_side
	app.set_hud_side("right")
	t.eq(str(SaveService.get_settings().get("hudSide", "")), "right", "the setting persists as hudSide")
	var rh := Hud.new()
	rh._ready()
	rh.banner("TIME!", RetroTheme.LIGHT["orange"])
	var rchip: Toast = rh.find_child("Toast", true, false)
	t.ok(rchip.side == "right" and rchip.anchor_left == 1.0 and absf(rchip.home_x() + Toast.SIDE_MARGIN + rchip.size.x) < 0.5, "a right-side toast rests 36 in from the right edge")
	rh.free()
	var screen_script: GDScript = load("res://game/screens/time_trial_screen.gd")
	var at: Dictionary = screen_script.music_positions("right")
	t.ok(absf(float(at["music"].x) - (720.0 - 36.0 - IconButton.SIZE)) < 0.5 and float(at["next"].x) < float(at["music"].x), "the note at the bottom-right with the chevron on its left")
	t.eq(screen_script.music_positions("left")["music"], screen_script.MUSIC_POS, "LEFT is the note where it always was")
	# The practice spot rail mirrors too (Ross, 2026-10-27): 36 in from the right edge, the chevron on its left.
	var rl: Dictionary = screen_script.spot_rail_layout("right", false)
	t.ok(absf(float(rl["x"]) - (720.0 - 36.0 - screen_script.SPOT_RAIL_W)) < 0.5 and str(rl["chevron"]) == ">" and bool(rl["chevron_first"]), "the practice spot rail sits 36 in from the right edge with the chevron on its left, pointing right")
	var rh2: Dictionary = screen_script.spot_rail_layout("right", true)
	t.ok(float(rh2["x"]) > float(rl["x"]) + 100.0 and str(rh2["chevron"]) == "<", "…hidden it slides off the right edge and the chevron points back")
	t.ok(absf(float(screen_script.spot_rail_layout("right", true, 230.0, 60.0)["x"]) - 660.0) < 0.5, "…a wider chevron still sits flush with the right edge")
	var ll: Dictionary = screen_script.spot_rail_layout("left", false)
	t.ok(absf(float(ll["x"]) - screen_script.SPOT_RAIL_X) < 0.5 and str(ll["chevron"]) == "<" and not bool(ll["chevron_first"]), "LEFT is the rail where it always was")
	# The guard box around the note and the chevron (Ross, 2026-10-25): a near miss starts no grab.
	var note := Rect2(screen_script.MUSIC_POS, Vector2.ONE * IconButton.SIZE)
	var chev := Rect2(screen_script.NEXT_POS, Vector2.ONE * screen_script.NEXT_SIZE)
	var g: float = screen_script.MUSIC_GUARD
	t.ok(not screen_script.guard_hit(note.get_center(), [note, chev], g), "a tap on the note is the note's")
	t.ok(not screen_script.guard_hit(chev.get_center(), [note, chev], g), "…and on the chevron the chevron's")
	t.ok(screen_script.guard_hit(note.position - Vector2(10, 10), [note, chev], g), "just off the note's corner is swallowed")
	t.ok(screen_script.guard_hit(Vector2(note.end.x + 4.0, note.position.y + 2.0), [note, chev], g), "…as is the gap above the smaller chevron")
	t.ok(not screen_script.guard_hit(note.position - Vector2(0, g + 6.0), [note, chev], g), "past the margin the court takes the grab")
	t.ok(not screen_script.guard_hit(Vector2(360, 900), [], g), "no buttons, no guard")
	app.set_hud_side(was_side)
	# The pause menu (design "Pause Menu" 43a, 2026-10-25): PAUSED and where
	# you are, a two-tap QUIT, three option tiles with popovers, RESUME.
	var pm := PauseMenu.new()
	pm._ready()
	for nm in ["Resume", "ShotHelp", "Ball", "Net", "Quit", "HudSide"]:
		t.ok(pm.find_child(nm, true, false) is ShadowCard, "the pause menu has %s" % nm)
	t.ok(pm.find_child("ResumeSub", true, false) == null, "RESUME carries no sub-line (43a update, 2026-10-27)")
	var was: int = app.shot_help
	# The line under PAUSED and the info row (43a update, 2026-10-27).
	t.eq(HudCopy.pause_context_match("ARCADE LEAGUE", "d5", "OLLIE KNOTS"), "ARCADE LEAGUE · MATCH 5 · VS OLLIE KNOTS", "a league match's line")
	t.eq(HudCopy.pause_context_match("ARCADE LEAGUE", "po-sf-2", "OLLIE", 1), "ARCADE LEAGUE · SEMIFINAL · GAME 2 · VS OLLIE · OT1", "a playoff game in overtime")
	t.eq(HudCopy.pause_context_match("ONLINE", "", "DRE"), "ONLINE · VS DRE", "an online match")
	t.eq(HudCopy.pause_stats_trial(18, 23.4, 31), [{"v": "18", "l": "SCORE", "gold": true}, {"v": "23.4", "l": "TIME LEFT", "gold": false}, {"v": "31", "l": "YOUR BEST", "gold": false}], "a trial's row")
	t.eq(HudCopy.pause_quit_warning("THIS RUN WON'T COUNT"), "TAP AGAIN\nTHIS RUN WON'T COUNT", "the armed QUIT's warning")
	t.eq(HudCopy.pause_quit_warning(""), "TAP AGAIN", "…alone when quitting costs nothing")
	pm.open({"context": HudCopy.pause_context_match("ARCADE LEAGUE", "d5", "OLLIE"), "stats": HudCopy.pause_stats_match(12, 9, "OLLIE", 41.7), "quit_note": HudCopy.pause_quit_note("league")})
	t.eq((pm.find_child("Context", true, false) as Label).text, "ARCADE LEAGUE · MATCH 5 · VS OLLIE", "the line under PAUSED says where you are")
	t.eq(pm.info_texts(), ["12 YOU", "VS.", "9 OLLIE", "41.7 TIME LEFT"], "the info row: your score, theirs, the time left")
	t.eq(HudCopy.pause_resume_sub(-1.0), "BACK TO PRACTICE · NO CLOCK", "practice has no clock")
	# HUD SIDE flips on a tap and tells the screen.
	var was_hud: String = app.hud_side
	var sides := []
	pm.hud_side_changed.connect(func(side: String) -> void: sides.push_back(side))
	(pm.find_child("HudSide", true, false) as Button).pressed.emit()
	t.ok(app.hud_side != was_hud and sides == [app.hud_side], "a tap flips HUD SIDE and says so")
	t.eq(pm.hud_side_text(), app.hud_side.to_upper(), "…the row reads it")
	app.set_hud_side(was_hud)
	t.eq(pm.shot_help_text(), HudCopy.shot_help_value(was), "the shot-help tile reads the setting")
	(pm.find_child("ShotHelp", true, false) as Button).pressed.emit()
	t.eq(pm.pop_kind(), "help", "a tap on the tile opens its popover")
	t.ok(pm.find_child("Help_0", true, false) != null and pm.find_child("Help_2", true, false) != null, "…every choice at once")
	(pm.find_child("ShotHelp", true, false) as Button).pressed.emit()
	t.eq(pm.pop_kind(), "", "the tile again closes it")
	(pm.find_child("ShotHelp", true, false) as Button).pressed.emit()
	(pm.find_child("Help_0", true, false) as Button).pressed.emit()
	t.ok(app.shot_help == 0 and pm.pop_kind() == "", "picking OFF sets it and closes")
	# QUIT takes two taps.
	var quits := [0]
	pm.quit.connect(func() -> void: quits[0] += 1)
	(pm.find_child("Quit", true, false) as Button).pressed.emit()
	t.ok(quits[0] == 0 and pm.quit_armed(), "the first tap only arms QUIT")
	t.eq((pm.find_child("QuitTop", true, false) as Label).text, "SURE?", "…SURE? on the square")
	t.eq((pm.find_child("QuitSub", true, false) as Label).text, "TAP AGAIN\nTHE MATCH WON'T BE PLAYED", "…saying what it costs over it")
	(pm.find_child("Quit", true, false) as Button).pressed.emit()
	t.eq(quits[0], 1, "the second quits")
	# The BALL and NET tiles (docs/LOCKER.md → NETS): the ball is global, the net per court.
	var cos_before: Dictionary = SaveService.get_cosmetics()
	var mode_before: String = app.next_mode
	var ball_before: String = app.ball_set.id if app.ball_set != null else "classic"
	var cos: Dictionary = SaveService.default_cosmetics()   # the suite's parts start empty (headless)
	cos.merge(SaveService.get_cosmetics(), true)
	cos["ball"] = {"selected": "classic", "owned": ["classic"]}
	cos["net"] = SaveService.default_nets()
	SaveService.put_cosmetics(cos)
	app.select("ball", "classic")
	app.next_mode = "trial"
	pm.open()
	t.eq(pm.ball_text(), "CLASSIC", "the BALL tile reads the equipped ball")
	t.eq(pm.net_text(), "COTTON", "the NET tile reads the cage's net")
	var balls_seen: Array = []
	var nets_seen: Array = []
	pm.ball_changed.connect(func(id: String) -> void: balls_seen.push_back(id))
	pm.net_changed.connect(func(id: String) -> void: nets_seen.push_back(id))
	(pm.find_child("Ball", true, false) as Button).pressed.emit()
	t.ok(pm.pop_kind() == "" and balls_seen.is_empty(), "one owned ball: the tile does not open")
	t.ok(not (pm.find_child("BallChevron", true, false) as Control).visible, "…and shows no caret")
	app.grant_cosmetic("ball", "cherry")
	pm.open()
	t.ok((pm.find_child("BallChevron", true, false) as Control).visible, "two owned balls: the caret is back")
	(pm.find_child("Ball", true, false) as Button).pressed.emit()
	t.ok(pm.pop_kind() == "ball" and pm.find_child("Opt_cherry", true, false) != null, "the popover shows the owned balls")
	(pm.find_child("Opt_cherry", true, false) as Button).pressed.emit()
	t.eq(balls_seen, ["cherry"], "picking one equips it and tells the screen")
	t.eq(app.ball_set.id, "cherry", "…globally (App.ball_set)")
	t.ok(pm.ball_text() == "CHERRY" and pm.pop_kind() == "", "…the tile follows and the popover closes")
	pm.pick("net", "chain")
	t.eq(nets_seen, ["chain"], "the stock chain hangs on the cage now (any net, any hoop)")
	t.eq(app.net_set_for("cage").id, "chain", "…saved for the cage")
	pm.pick("net", "cotton")
	t.eq(pm.net_text(), "COTTON", "back to cotton")
	nets_seen.clear()
	app.next_mode = "city"
	app.grant_cosmetic("net", "jack")
	pm.open()
	t.eq(pm.net_text(), "CHAIN", "the city hangs its stock chain")
	pm.pick("net", "jack")
	t.eq(nets_seen, ["jack"], "a pick hangs it on this court")
	t.eq(app.net_set_for("city").id, "jack", "…saved for the city")
	t.eq(app.net_set_for("cage").id, "cotton", "…and the cage keeps its cotton")
	pm.pick("net", "jack")
	t.eq(nets_seen, ["jack"], "picking what is on changes nothing")
	app.select_net("city", "chain")
	app.next_mode = mode_before
	SaveService.put_cosmetics(cos_before)
	app.select("ball", ball_before)
	app.set_shot_help(was)
	var resumed := []
	pm.resumed.connect(func() -> void: resumed.push_back(true))
	(pm.find_child("Resume", true, false) as Button).pressed.emit()
	t.eq(resumed.size(), 1, "RESUME emits")
	pm.free()
	var pb := IconButton.new("pause")
	t.eq(pb.kind, "pause", "the pause icon button")
	pb.free()
	var sw := ToggleSwitch.new(false)
	t.ok(not sw.on, "a switch starts off")
	sw.set_on(true)
	t.ok(sw.on, "and flips on")
	sw.free()
