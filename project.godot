; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hoop Shoot League"
config/version="1.0.0"
run/main_scene="res://game/screens/splash_screen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon/icon_1024.png"
boot_splash/bg_color=Color(0.12156863, 0.05882353, 0.047058824, 1)
boot_splash/stretch_mode=4
boot_splash/use_filter=true
boot_splash/image="res://assets/splash/boot_splash.png"

[autoload]

SaveService="*res://game/autoload/save_service.gd"
Sfx="*res://game/autoload/sfx.gd"
Net="*res://game/net/net_client.gd"
Platform="*res://game/net/platform.gd"
App="*res://game/autoload/app.gd"
QaDriver="*res://tools/qa_driver.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Hoop Shoot"

[gui]

common/default_scroll_deadzone=18

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

limits/time/time_rollover_secs=259200.0

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
